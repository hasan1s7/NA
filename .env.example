# Copy to .env locally. Never commit .env or put these secrets in public/.
# Docker Compose loads .env. python server.py alone expects exported variables.
# Use this exact address in your browser; localhost and 127.0.0.1 are different origins.
NABU_ORIGIN=http://localhost:8000
NABU_HOST=0.0.0.0
PORT=8000
NABU_DB=/data/nabu.sqlite3
# Public signup is opt-in. Use an invitation instead for a private beta.
NABU_OPEN_SIGNUP=true
NABU_INVITE_CODE=

DEEPL_API_KEY=
# auto omits the optional model preference; useful if a plan rejects that parameter.
DEEPL_MODEL_TYPE=prefer_quality_optimized
DEEPL_ENGLISH_TARGET=EN-US
DEEPL_PORTUGUESE_TARGET=PT-BR
NABU_TRANSLATION_DAILY_CHARS=50000

ELEVENLABS_API_KEY=
# Copy an accessible, licensed voice ID from ElevenLabs My Voices.
ELEVENLABS_VOICE_ID=
# Existing configurable model; verify availability for your account.
# Other implemented choices: eleven_v3, eleven_multilingual_v2, eleven_flash_v2_5.
ELEVENLABS_MODEL_ID=eleven_v4
# Optional per-language overrides. Use actual voice IDs, not these example names:
# ELEVENLABS_VOICES_JSON='{"en":"EN_VOICE_ID","fr":"FR_VOICE_ID","ar":"AR_VOICE_ID","zh-CN":"ZH_VOICE_ID","ru":"RU_VOICE_ID","es":"ES_VOICE_ID"}'
ELEVENLABS_VOICES_JSON='{}'
NABU_SPEECH_DAILY_CHARS=10000
NABU_SPEECH_USER_DAILY_CHARS=3000

# Local snapshots every six hours. Local backups do NOT protect against disk loss.
NABU_BACKUP_ENABLED=true
NABU_BACKUP_INTERVAL_SECONDS=21600
# Set these privately to enable encrypted off-server backups to an existing private S3-compatible bucket.
NABU_BACKUP_BUCKET=
NABU_BACKUP_KEY=
NABU_BACKUP_ENDPOINT=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Generate and keep a second secure copy of the encryption key:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes off-server backups unrecoverable. Never commit it.

# Public app-link association metadata, not API secrets. Optional until signing.
# NABU_MOBILE_APP_ID=app.nabu.learn
# NABU_APPLE_TEAM_ID=YOURTEAMID
# NABU_ANDROID_SHA256=AA:BB:... (32 signing-certificate bytes; comma-separate rotation keys)
# NABU_API_ORIGIN is a local mobile BUILD variable, not a provider key.

# Optional, local-only speech recognition. See MEDIA_SETUP.md.
NABU_WHISPER_MODEL_DIR=
