# Copied to private .env.local by start_local.py. Never publish .env.local.
# The launcher always binds to 127.0.0.1; this file cannot expose the server.
PORT=8000
NABU_DB=.data/nabu.sqlite3
NABU_OPEN_SIGNUP=true
NABU_INVITE_CODE=
# No API keys are required for the bundled words, accounts, reviews or sharing.
DEEPL_API_KEY=
DEEPL_MODEL_TYPE=prefer_quality_optimized
DEEPL_ENGLISH_TARGET=EN-US
DEEPL_PORTUGUESE_TARGET=PT-BR
NABU_TRANSLATION_DAILY_CHARS=50000
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICES_JSON={}
NABU_SPEECH_DAILY_CHARS=10000
NABU_SPEECH_USER_DAILY_CHARS=3000
# Local snapshots are enabled. These do NOT protect against loss of this disk.
NABU_BACKUP_ENABLED=true
NABU_BACKUP_INTERVAL_SECONDS=21600
NABU_BACKUP_BUCKET=
NABU_BACKUP_KEY=
NABU_BACKUP_ENDPOINT=

# Optional, local-only speech recognition. See MEDIA_SETUP.md.
NABU_WHISPER_MODEL_DIR=
